#!/usr/bin/env bash
# GitHub App installation token for the coding agent.
#
# Usage:
#   gh-app-token                      Prints an installation access token.
#   gh-app-token --git-credential get Prints git credential helper output (username and token).
#   gh-app-token --env                Prints shell lines for Claude Code's CLAUDE_ENV_FILE.
#
# Configuration file: $GH_APP_CONFIG, default ~/.config/gh-app/config
#   APP_ID=<App ID or Client ID>
#   INSTALLATION_ID=<installation ID>
#   PRIVATE_KEY=<path to the App's .pem private key>
#
# Tokens are cached in ~/.cache/gh-app (mode 600) and replaced 50 minutes after issue.
# GitHub installation tokens expire 60 minutes after issue.
# Requirements: bash, curl, openssl.
set -eo pipefail

CONFIG="${GH_APP_CONFIG:-$HOME/.config/gh-app/config}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/gh-app"
REFRESH_AFTER_SECONDS=3000
API_URL="${GH_APP_API_URL:-https://api.github.com}"

fail() {
  printf 'gh-app-token: %s\n' "$*" >&2
  exit 1
}

base64url() {
  base64 | tr -d '\n=' | tr '+/' '-_'
}

load_config() {
  [ -r "$CONFIG" ] || fail "configuration file not readable: $CONFIG"
  # shellcheck disable=SC1090
  . "$CONFIG"
  [ -n "$APP_ID" ] || fail "APP_ID is not set in $CONFIG"
  [ -n "$INSTALLATION_ID" ] || fail "INSTALLATION_ID is not set in $CONFIG"
  [ -n "$PRIVATE_KEY" ] || fail "PRIVATE_KEY is not set in $CONFIG"
  PRIVATE_KEY="${PRIVATE_KEY/#\~/$HOME}"
  [ -r "$PRIVATE_KEY" ] || fail "private key not readable: $PRIVATE_KEY"
  CACHE_FILE="$CACHE_DIR/token-$INSTALLATION_ID"
}

# JSON value of the iss claim: a number for an App ID, a string for a Client ID.
issuer_claim() {
  case "$APP_ID" in
    *[!0-9]*) printf '"%s"' "$APP_ID" ;;
    *) printf '%s' "$APP_ID" ;;
  esac
}

# Signed JWT for the App, valid from 60 seconds ago to 9 minutes from now.
app_jwt() {
  local now header payload unsigned signature
  now=$(date +%s)
  header=$(printf '{"alg":"RS256","typ":"JWT"}' | base64url)
  payload=$(printf '{"iat":%d,"exp":%d,"iss":%s}' $((now - 60)) $((now + 540)) "$(issuer_claim)" | base64url)
  unsigned="$header.$payload"
  signature=$(printf '%s' "$unsigned" | openssl dgst -sha256 -sign "$PRIVATE_KEY" -binary | base64url) \
    || fail "signing with $PRIVATE_KEY failed"
  printf '%s.%s' "$unsigned" "$signature"
}

request_token() {
  local response token message
  response=$(curl -sS -X POST \
    -H "Authorization: Bearer $(app_jwt)" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "$API_URL/app/installations/$INSTALLATION_ID/access_tokens") \
    || fail "request to $API_URL failed"
  token=$(printf '%s\n' "$response" | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
  if [ -z "$token" ]; then
    message=$(printf '%s\n' "$response" | sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
    fail "GitHub returned no token: ${message:-$response}"
  fi
  printf '%s' "$token"
}

cached_token() {
  local issued token
  [ -r "$CACHE_FILE" ] || return 1
  { read -r issued && read -r token; } < "$CACHE_FILE" || return 1
  case "$issued" in "" | *[!0-9]*) return 1 ;; esac
  [ -n "$token" ] || return 1
  [ $(($(date +%s) - issued)) -lt "$REFRESH_AFTER_SECONDS" ] || return 1
  printf '%s' "$token"
}

token() {
  local token tmp
  load_config
  if cached_token; then
    return 0
  fi
  token=$(request_token)
  mkdir -p "$CACHE_DIR"
  chmod 700 "$CACHE_DIR"
  tmp=$(mktemp "$CACHE_DIR/token.XXXXXX")
  chmod 600 "$tmp"
  printf '%s\n%s\n' "$(date +%s)" "$token" > "$tmp"
  mv -f "$tmp" "$CACHE_FILE"
  printf '%s' "$token"
}

self_path() {
  printf '%s/%s' "$(cd "$(dirname "$0")" && pwd)" "$(basename "$0")"
}

case "${1:-}" in
  "")
    token
    printf '\n'
    ;;
  --git-credential)
    # Git passes get, store or erase. Only get returns credentials.
    cat > /dev/null
    if [ "${2:-}" = "get" ]; then
      printf 'username=x-access-token\npassword=%s\n' "$(token)"
    fi
    ;;
  --env)
    self=$(self_path)
    cat <<EOF
export GH_TOKEN="\$('$self' || printf 'gh-app-token-failed')"
export GIT_CONFIG_COUNT=4
export GIT_CONFIG_KEY_0='credential.https://github.com.helper'
export GIT_CONFIG_VALUE_0=''
export GIT_CONFIG_KEY_1='credential.https://github.com.helper'
export GIT_CONFIG_VALUE_1='!$self --git-credential'
export GIT_CONFIG_KEY_2='url.https://github.com/.insteadOf'
export GIT_CONFIG_VALUE_2='git@github.com:'
export GIT_CONFIG_KEY_3='url.https://github.com/.insteadOf'
export GIT_CONFIG_VALUE_3='ssh://git@github.com/'
EOF
    ;;
  *)
    fail "unknown option: $1"
    ;;
esac
