{
  "name": "master",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/master"
      ],
      "exclude": []
    },
    "repository_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [],
      "protected": false
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "require_extra_approval_for_unattributed_changes": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge"
        ],
        "required_reviewers": [
          {
            "minimum_approvals": 1,
            "file_patterns": [
              "*"
            ],
            "reviewer": {
              "id": "<release-approvers team ID>",
              "type": "Team"
            }
          }
        ]
      }
    },
    {
      "type": "workflows",
      "parameters": {
        "do_not_enforce_on_create": false,
        "workflows": [
          {
            "repository_id": "<.github repository ID>",
            "path": ".github/workflows/pr-policy.yml",
            "ref": "refs/heads/master"
          }
        ]
      }
    }
  ]
}
